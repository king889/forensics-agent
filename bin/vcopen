#!/usr/bin/env bash
# 打开 VeraCrypt / TrueCrypt 容器（只读），并把内容列出来。
#
#   vcopen <容器> [--password P] [--keyfile K] [--dest DIR]
#   vcopen xcontainer --password '0x548d...' --keyfile work/vera_key
#
# 为什么需要这个脚本：
#   cryptsetup 的 tcrypt 模式依赖内核 AF_ALG（algif_skcipher），WSL 默认不加载；
#   而 tcryptOpen 建 dm-crypt 设备必须 root。这两个坑每次都让人卡住，
#   脚本把探测、报错、修复命令一次讲清楚。
#
# 三种情形：
#   1. 内核模块没加载 → 打印 `sudo modprobe algif_skcipher`
#   2. 模块在但没有 root → 打印完整的 sudo cryptsetup 命令，复制即可
#   3. 有 root（或用 sudo 跑本脚本）→ 直接挂载并列出文件
set -uo pipefail

CS="${CRYPTSETUP:-$(command -v cryptsetup || echo "$HOME/projects/forensics/tools/bin/cryptsetup")}"
VOL=""; PW=""; KEYF=""; DEST=""

while [ $# -gt 0 ]; do
    case "$1" in
        --password) PW="$2"; shift 2 ;;
        --keyfile)  KEYF="$2"; shift 2 ;;
        --dest)     DEST="$2"; shift 2 ;;
        -h|--help)  sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *)          VOL="$1"; shift ;;
    esac
done

[ -n "$VOL" ] || { echo "用法: vcopen <容器> [--password P] [--keyfile K]" >&2; exit 2; }
[ -f "$VOL" ] || { echo "找不到容器: $VOL" >&2; exit 2; }

size=$(stat -c %s "$VOL")
echo "容器: $VOL  ($size 字节)"
if [ $((size % 512)) -ne 0 ]; then
    echo "警告: 大小不是 512 的整数倍，可能不是 VC/TC 卷" >&2
fi

if [ -z "$DEST" ]; then
    DEST="/tmp/vc-$(basename "$VOL")"
fi

# ---- 1. 能力探测 ----
# 两个条件缺一不可：AF_ALG 接口（algif_skcipher）+ 内核里有 xts(aes)。
# WSL 的内核通常只编了 aes/lrw，没有 xts，连模块文件都找不到，
# 所以 cryptsetup 在这类环境上永远不可用 —— 必须直接告诉人，别让它白试。
have_alg=0; grep -q '^algif_skcipher' /proc/modules 2>/dev/null && have_alg=1
have_xts=0; grep -q 'xts(' /proc/crypto 2>/dev/null && have_xts=1

if [ "$have_alg" = 0 ] || [ "$have_xts" = 0 ]; then
    echo
    if [ "$have_alg" = 0 ]; then
        echo "缺 AF_ALG 接口：先跑  sudo modprobe algif_skcipher"
    fi
    if [ "$have_xts" = 0 ]; then
        echo "缺内核 xts(aes) 算法（/proc/crypto 里没有 xts）—— 这一项无法用 modprobe 补："
        echo "  模块文件: $(ls /lib/modules/$(uname -r)/kernel/crypto/xts.ko* 2>/dev/null || echo '不存在，内核没编')"
        echo "  结论: 本机 cryptsetup 无法处理 VeraCrypt 卷。可选方案："
        echo "    1. 换一台带 xts 的 Linux（或 WSL 自定义内核）跑挂载"
        echo "    2. 用 VeraCrypt 官方 CLI（用户态实现，仍需 root/FUSE 才能挂载）"
        echo "    3. 纯 Python 解密（cryptography 支持 AES-XTS，无需 root）—— 尚未实现"
        echo
        exit 3
    fi
    echo
fi

keyargs=()
[ -n "$KEYF" ] && keyargs+=(--key-file "$KEYF")

# ---- 2. 先做只读探测（不需要 root）----
echo "=== tcryptDump（只读探测，不改动容器）==="
if [ -n "$PW" ]; then
    printf '%s' "$PW" | "$CS" tcryptDump --veracrypt "${keyargs[@]}" "$VOL" 2>&1 | sed 's/^/  /'
    rc=${PIPESTATUS[1]}
else
    echo "  未提供 --password，跳过（tcryptDump 会等待交互输入）"
    rc=1
fi

if [ $rc -ne 0 ]; then
    echo
    echo "探测失败。常见原因："
    echo "  - 内核模块没加载（见上面的 sudo modprobe）"
    echo "  - 密码 / 密钥文件不对"
    echo "  - 不是 VeraCrypt 卷（可能是 TrueCrypt，去掉 --veracrypt 试试）"
    exit 1
fi

# ---- 3. 挂载 ----
echo
echo "=== 挂载到 $DEST（只读）==="
mkdir -p "$DEST"
cmd=("$CS" tcryptOpen --veracrypt "${keyargs[@]}" --readonly "$VOL" "$(basename "$DEST")")
if [ "$(id -u)" -ne 0 ]; then
    echo "建 dm-crypt 设备需要 root。复制下面这条执行："
    echo
    printf '    sudo'
    [ -n "$PW" ] && printf " sh -c 'echo -n %q | cryptsetup tcryptOpen --veracrypt" "$PW"
    [ -n "$KEYF" ] && printf " --key-file %q" "$(realpath "$KEYF")"
    printf " --readonly %q %q'\n" "$(realpath "$VOL")" "$(basename "$DEST")"
    echo
    echo "  然后: sudo cryptsetup status $(basename "$DEST")"
    echo "        sudo mount -o ro /dev/mapper/$(basename "$DEST") $DEST && ls -la $DEST"
    echo "  用完: sudo umount $DEST && sudo cryptsetup close $(basename "$DEST")"
    exit 0
fi

if [ -n "$PW" ]; then
    printf '%s' "$PW" | "${cmd[@]}" 2>&1 | sed 's/^/  /'
else
    "${cmd[@]}" 2>&1 | sed 's/^/  /'
fi
mount -o ro "/dev/mapper/$(basename "$DEST")" "$DEST" && ls -la "$DEST"
